{
  "name": "loadbearing-lite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "dev": "node tooling/scripts/task.mjs dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . && eslint .",
    "format": "biome check --write .",
    "test": "pnpm -r run test",
    "clean": "pnpm -r --parallel run clean",
    "check": "node tooling/scripts/task.mjs check",
    "infra": "node tooling/scripts/task.mjs infra",
    "db": "node tooling/scripts/task.mjs db",
    "seed:dev": "pnpm --filter @loadbearing/infrastructure run seed:dev",
    "seed:prod": "pnpm --filter @loadbearing/infrastructure run seed:prod",
    "ops": "node tooling/scripts/task.mjs ops",
    "smoke": "node tooling/scripts/task.mjs smoke",
    "bench": "node tooling/scripts/bench.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@loadbearing/eslint-config": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "rimraf": "catalog:",
    "sherif": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:"
  }
}
